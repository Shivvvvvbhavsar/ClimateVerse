# ==============================================================================
# ClimateVerse environment configuration
# Copy this file to `.env` and adjust if needed. ClimateVerse works out of the
# box with ALL of these left at their defaults — no API keys are required.
# ==============================================================================

# --- Demo mode ---
# When true (default), the platform uses synthetic DEMO DATA for Pune and
# deterministic rule-based AI agents / copilot. No external API calls are made.
DEMO_MODE=true

# --- Database ---
# Default: local SQLite file, created and seeded automatically on first run.
# No PostgreSQL/PostGIS install required for the default demo experience.
DATABASE_URL=sqlite:///./climateverse.db

# --- Auth ---
# Change this in any real deployment. Not security-sensitive for local demo use.
JWT_SECRET=climateverse-demo-secret-change-in-production

# --- Optional live integrations ---
# Leave blank to stay in demo mode. If set, future extensions of the Copilot /
# agents can call a live LLM instead of the deterministic rule-based logic.
# The app will NEVER crash if this is missing.
OPENAI_API_KEY=

# --- Frontend ---
# URL the Next.js frontend uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
